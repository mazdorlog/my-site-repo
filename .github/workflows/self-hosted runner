name: Self Hosted Deployment v2

on:
  push:
    branches:
      - master

jobs:
  deploy:
    runs-on: self-hosted

    steps:
      - name: Download Repository
        uses: actions/checkout@v4

      - name: Deploy
          run: |
            cd /var/www/myapp
            git pull
            npm install
            npm run build
            pm2 restart app
