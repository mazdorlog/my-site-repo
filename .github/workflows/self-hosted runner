name: Self Hosted Deployment v2

on:
  push:
    branches:
      - master

jobs:
  deploy:
    runs-on: self-hosted

    steps:
      - name: Download Repository
        uses: actions/checkout@v4

      - name: Deploy Website Files
        run: |
          sudo rm -rf /var/www/mysite/*
          sudo cp -r * /var/www/mysite/
          sudo systemctl restart nginx
