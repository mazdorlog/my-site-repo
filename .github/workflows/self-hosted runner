name: Self Hosted Deployment v2

on:
  push:
    branches:
      - master

jobs:
  deploy:
    runs-on: self-hosted

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Copy Files
        run: |
          sudo rm -rf /var/www/myapp/*
          sudo cp -r . /var/www/myapp/

      - name: Install Dependencies
        run: |
          cd /var/www/myapp
          npm install

      - name: Build App
        run: |
          cd /var/www/myapp
          npm run build

      - name: Restart PM2
        run: |
          pm2 restart app
